# OneBridge Grid production settings (D-VPS-DEPLOY B6).
# Copy to .env on the server, fill every empty value, then: chmod 600 .env
# Never commit .env. Generate secrets on the server with the command shown next to each one.
# Values with spaces or < > need quotes. No value may contain a newline.

# ---- Site ------------------------------------------------------------------------------------
# The domain Caddy serves (and gets HTTPS certificates for). www.<domain> redirects here.
SITE_DOMAIN=onebridgecard.com
# Baked into the browser code at build time: changing it needs a rebuild (deploy.sh does that).
PUBLIC_URL=https://onebridgecard.com
# The admin app's address (links in emails, CORS, sign-in origin checks).
APP_URL=https://onebridgecard.com
# The public site's address (card pages, QR short links at <WEB_PUBLIC_URL>/r/<code>).
WEB_PUBLIC_URL=https://onebridgecard.com
NODE_ENV=production

# ---- Sign-in (D-AUTH-EMAIL) ---------------------------------------------------------------------
# Production allows google and email only; phone is refused.
AUTH_METHODS=google,email
# Google Cloud console > APIs & Services > Credentials > OAuth 2.0 Client ID (type: Web application).
# Authorised JavaScript origin: https://onebridgecard.com. No client secret is needed.
GOOGLE_CLIENT_ID=

# ---- Email (sign-in codes, invites, lead notices) ------------------------------------------------
# Any SMTP provider: Zoho ZeptoMail, Amazon SES SMTP, Brevo... Values come from the provider.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="OneBridge <no-reply@onebridgecard.com>"
EMAIL_REPLY_TO=support@onebridgecard.com

# ---- Secrets: each one with  openssl rand -hex 48  unless stated ---------------------------------
# Signs sign-in tokens. Changing it signs everyone out (safe to rotate).
JWT_SECRET=
# Lets the services call each other's /internal endpoints. Safe to rotate (restart all).
INTERNAL_SERVICE_KEY=
# openssl rand -hex 32   (exactly 64 hex characters)
# Encrypts leads, invite contacts and messages. BACK IT UP in the company password manager:
# losing it makes that data unreadable, and changing it needs a planned re-encryption.
ENCRYPTION_KEY=
# Signs the api's "refresh this card page" calls to the public site.
REVALIDATION_SIGNING_SECRET=

# ---- Cookies --------------------------------------------------------------------------------------
COOKIE_SECURE=true
# The browser reaches identity at /svc/identity, so its cookies live under this path.
COOKIE_PATH=/svc/identity/auth

# ---- MongoDB (inside Docker only; never published) --------------------------------------------
MONGO_ROOT_USER=root
# openssl rand -hex 24
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=onebridge
# openssl rand -hex 24   (hex only, so it needs no escaping in MONGODB_URI)
MONGO_APP_PASSWORD=
# openssl rand -base64 756 | tr -d '\n'   (the replica set's internal key)
MONGO_KEYFILE_CONTENT=
# Put the same app password in place of CHANGE_ME:
MONGODB_URI=mongodb://onebridge:CHANGE_ME@mongo:27017/onebridge?replicaSet=rs0&authSource=onebridge

# ---- Files ----------------------------------------------------------------------------------------
# Logo uploads (a Docker volume, included in backups).
MEDIA_DIR=/data/media

# ---- Optional -----------------------------------------------------------------------------------
# Cloudflare Turnstile secret for the card share-back form. Leave empty until the card page
# shows the Turnstile widget (not built yet); setting it now would block every share-back.
TURNSTILE_SECRET=
# Abuse limits (defaults shown).
MEMBER_REQUESTS_PER_MONTH=5
DAILY_NEW_CONVERSATION_CAP=30
DAILY_FOLLOW_CAP=200
ANON_SEARCH_PER_MINUTE=60

# ---- Backups (deploy/backup.sh) -----------------------------------------------------------------
# An rclone remote and folder, set up with `rclone config` (e.g. Backblaze B2): b2:onebridge-backups
BACKUP_RCLONE_REMOTE=
# openssl rand -hex 32   Encrypts every backup. Store it in the password manager: without it a
# backup cannot be restored.
BACKUP_PASSPHRASE=
# Where backup summaries are emailed (needs `mail` on the server; otherwise they are only printed).
ALERT_EMAIL=

# ---- Must stay off in production (prod-api.mjs refuses to start if any is true) ------------------
# ENABLE_FAKE_OTP, ENABLE_FAKE_OAUTH, DEMO_LEADS_PANEL, DEMO_MODE, DEMO_ACCESS_PASSCODE, ALLOW_REMOTE_SEED
