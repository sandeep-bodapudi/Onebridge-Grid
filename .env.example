# Environment Configuration for OneBridge Grid
# Copy this file to .env for local development

NODE_ENV=development
PORT=4001
APP_URL=http://localhost:3000

# Database
# Note: In development, only local addresses (localhost / 127.0.0.1) are accepted
# unless ALLOW_REMOTE_SEED=true is explicitly set.
MONGODB_URI=mongodb://127.0.0.1:27017/onebridge_dev
ALLOW_REMOTE_SEED=false

# Authentication & Security
JWT_SECRET=dev-jwt-secret-key-at-least-32-characters-long
INTERNAL_SERVICE_KEY=dev-internal-service-key-at-least-32-chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cookie Configuration
# In local dev / e2e over plain HTTP, COOKIE_SECURE is false. In production, always true.
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Development Fakes (Strictly rejected if NODE_ENV=production or unset)
ENABLE_FAKE_OTP=true
ENABLE_FAKE_OAUTH=true
