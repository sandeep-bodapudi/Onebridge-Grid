{
  "name": "@onebridge/api-contracts",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "contracts:gen": "openapi-typescript openapi.yaml -o src/api-types.ts && openapi-typescript network.yaml -o src/network-types.ts",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc"
  },
  "devDependencies": {
    "openapi-typescript": "^6.7.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "openapi-fetch": "^0.8.2"
  }
}
